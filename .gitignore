# Sırlar — asla commit edilmez
.env
.env.*
!.env.example
*.key
.streamlit/secrets.toml

# Çalışma çıktıları (lokal artifacts)
*.pkl

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# OS / editör
.DS_Store
.idea/
.vscode/

# Büyük ham veri — yalnız türev/temiz extract'ler repo'da
data/**/raw/*.tsv
data/**/raw/*.dta

# `runs/` tek seviyeli joker ile dışlanır (B1: üst dizini tamamen dışlarsak Git
# negasyonların altına hiç inmez, `!runs/llm_cache/...` işe yaramaz kalırdı).
runs/*
# Ancak S3-05 Canned Mode gereği Golden-path LLM cache yanıtları repoda paketlenmelidir!
!runs/llm_cache/
!runs/llm_cache/**