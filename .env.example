# BYOK — kendi anahtarların. Bu dosya şablon; gerçek anahtarları .env'e koy (gitignore'lu).
# yargı modeli pinli Gemini; mekanikte Groq/OpenRouter failover.
GEMINI_API_KEY=
GEMINI_PAID_API_KEY=      # private mod (no-train + DPA)
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=           # build.nvidia.com (NIM) — yalnız PUBLIC judge slotu

# --- Model seçimleri ---
# Yeni model çıkınca kod değişmez, buradaki satır değişir.
# Çözüm sırası: uygulama içi seçim → bu dosya → st.secrets → koddaki default.
# JUDGE: uygulama içi sağlayıcı+model seçimi hem public hem private modu etkiler
# (kullanıcı yalnız sağlayıcı/model listesinden seçer; provider/api_key_env/
# no_train her zaman koddaki slotta pinli kalır). MECHANICAL'da seçim yoktur, UI'da
# hiç gösterilmez — aşağıdaki satırlar deploy sahibinin kontrolündedir.
# Boş bırakılan = koddaki default.
GEMINI_JUDGE_MODEL=gemini-3.5-flash
GEMINI_JUDGE_PRIVATE_MODEL=gemini-3.1-pro
GEMINI_MECHANICAL_MODEL=gemini-flash-lite

GROQ_JUDGE_MODEL=llama-3.3-70b-versatile
GROQ_JUDGE_PRIVATE_MODEL=llama-3.3-70b-versatile   # Groq ZDR hesap-seviyesinde (bkz. not aşağıda)
GROQ_MECHANICAL_MODEL=llama-3.3-70b-versatile # hem public hem private mekanik zincir

OPENROUTER_JUDGE_MODEL=deepseek/deepseek-r1:free
OPENROUTER_JUDGE_PRIVATE_MODEL=deepseek/deepseek-r1  # ZDR istek-bazlı zorlanır, ":free" değil
OPENROUTER_MECHANICAL_MODEL=deepseek/deepseek-r1:free

NVIDIA_JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b  # private karşılığı YOK (NIM free ZDR vermez)

# JUDGE sağlayıcısını bu dosyadan sabitle. Boş = koddaki default (Gemini).
# Geçerli değerler: google · groq · openrouter · nvidia (PRIVATE modda nvidia yok).
# Uygulama içi seçim bunu ezer; scriptler (Streamlit yokken) yalnız bunu görür —
# scripts/run_model_benchmark.py sağlayıcı hedeflemeyi böyle yapıyor.
PARETO_JUDGE_PROVIDER=

# L7 Prompt Guard (Groq classification scanner)
# `PARETO_ENABLE_L7_PROMPT_GUARD` için kapatma değerleri: 0, false, off, no
PARETO_ENABLE_L7_PROMPT_GUARD=1
PARETO_L7_PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
PARETO_L7_PROMPT_GUARD_THRESHOLD=0.5

# Not: no-train/ZDR garantisi sağlayıcıya göre farklı doğrulanır.
#   Groq:       hesap-seviyesinde ayar, console.groq.com/settings/data-controls adresinden
#               açılır. GROQ_API_KEY'in bağlı olduğu hesapta fiilen açık olduğunu ops olarak
#               teyit edin, kod garanti edemez (UI'da private+Groq seçilince kullanıcıya da
#               hatırlatılır, bkz. streamlit_ui.py: _render_model_choice).
#   OpenRouter: istek-bazlı zorlanır (openrouter_provider.zdr=true, router.py'de kodlu),
#               yalnız private judge slotunda aktif. ":free" model ID'leri bu garantiyi taşımaz.
#   NVIDIA:     ücretsiz NIM ucu no-train/ZDR garantisi VERMEZ. Bu yüzden NVIDIA slotu
#               yalnız PUBLIC katmanda kayıtlıdır; private mod onu hiç görmez.
